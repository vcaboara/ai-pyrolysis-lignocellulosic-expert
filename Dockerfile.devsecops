FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /workspace

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Install both runtime and dev tooling dependencies used by run_local_ci.py.
COPY pyrolysis_lignocellulosic_ai_training/requirements.txt /tmp/requirements.txt
COPY requirements-dev.txt /tmp/requirements-dev.txt
RUN python -m pip install --upgrade pip \
    && python -m pip install -r /tmp/requirements.txt \
    && python -m pip install -r /tmp/requirements-dev.txt

# Copy only repo paths needed by the local CI gates.
# Files
COPY pyproject.toml \
    run_local_ci.py \
    ./
# Directories
COPY pyrolysis_lignocellulosic_ai_training ./pyrolysis_lignocellulosic_ai_training
COPY scripts ./scripts
COPY tests ./tests
COPY utils ./utils

CMD ["python", "run_local_ci.py", "--tests", "--security", "--privacy", "--format", "--lint", "--mypy"]
